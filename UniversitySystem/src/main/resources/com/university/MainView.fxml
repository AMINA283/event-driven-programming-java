
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.university.MainController">

    <left>
        <VBox spacing="20"
              prefWidth="200"
              style="-fx-background-color: #243447; -fx-padding: 25;">

            <Label text="UNIVERSITY"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Button text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"/>

            <Button text="Students"
                    onAction="#showStudents"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="centerPane"
                   style="-fx-background-color: #f4f6f8; -fx-padding: 20;"/>
    </center>

</BorderPane>


